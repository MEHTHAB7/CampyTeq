# Environment variables for CampyTeq

# Django
DEBUG=True
SECRET_KEY=campyteq-dev-insecure-key-change-in-production-^9k8w!3z$x2q
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# Database
# Default uses local PostgreSQL or falls back to SQLite if DATABASE_URL is not set
DATABASE_URL=postgresql://campyteq_user:campyteq_pass@localhost:5432/campyteq_db
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=campyteq_db
# DB_USER=campyteq_user
# DB_PASSWORD=campyteq_pass
# DB_HOST=localhost
# DB_PORT=5432

# Redis & Cache
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/0

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# JWT Settings
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=60
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws
