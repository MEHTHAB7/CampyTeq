# ==============================================================================
# CampyTeq Production Environment Configuration
# ==============================================================================

# Core Django Security
DEBUG=False
SECRET_KEY=generate-a-strong-random-50-character-secret-key-for-production!
ALLOWED_HOSTS=campyteq.edu,api.campyteq.edu,localhost,127.0.0.1

# PostgreSQL Database
POSTGRES_DB=campyteq_db
POSTGRES_USER=campyteq_prod_user
POSTGRES_PASSWORD=replace_with_ultra_secure_password_here
DATABASE_URL=postgresql://campyteq_prod_user:replace_with_ultra_secure_password_here@postgres:5432/campyteq_db

# Redis Cache & Broker
REDIS_URL=redis://redis:6379/1

# CORS Origins
CORS_ALLOWED_ORIGINS=https://campyteq.edu,https://api.campyteq.edu

# Next.js Frontend
NEXT_PUBLIC_API_URL=https://api.campyteq.edu/api/v1
NODE_ENV=production

# Computer Vision Edge Ingestion Secret
CV_GATEWAY_TOKEN=campyteq-edge-shared-secret-token
